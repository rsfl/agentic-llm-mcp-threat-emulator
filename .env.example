# ============================================================
# Agentic LLM MCP Threat Emulator -- Environment Variables
# Copy to .env and fill in your values.
# Never commit .env to source control.
# ============================================================

# ── Anthropic API ─────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenRouter API ────────────────────────────────────────
# Get your key at: https://openrouter.ai/keys
# Free tier available -- no billing required for :free models
OPENROUTER_API_KEY=sk-or-...

# ── Splunk (override defaults from config/settings.py) ───
# Only needed if your Splunk instance differs from the
# splunk-mcp-llm-siemulator defaults.
# SPLUNK_HEC_TOKEN=your-hec-token-here
# SPLUNK_HEC_URL=http://localhost:8088/services/collector/event

# ── Ollama (override if not running on localhost) ─────────
# OLLAMA_URL=http://localhost:11434
